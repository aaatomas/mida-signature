# Optional: Keycloak/OIDC issuer for logout redirect (default https://auth.onmida.lt/realms/mida).
# VITE_OIDC_ISSUER_URL=https://auth.onmida.lt/realms/mida
# Optional: OIDC client_id for Keycloak logout (default oauth2-proxy).
# VITE_OIDC_CLIENT_ID=oauth2-proxy
# Dev only: proxy /oauth2 to a real oauth2-proxy so localhost login/logout hit Keycloak.
# VITE_DEV_OAUTH_PROXY_TARGET=https://signature.onmida.lt
